import BasicLayout from '@/layouts/BasicLayout.vue'
import type { RouteRecordRaw } from 'vue-router'
import { createRouter, createWebHistory } from 'vue-router'

const pluginModules = import.meta.glob('../plugins/*/index.ts', { eager: true }) as Record<
  string,
  { routes?: RouteRecordRaw[] }
>

function pluginRoutes(): RouteRecordRaw[] {
  return Object.values(pluginModules).flatMap((plugin) => plugin.routes ?? [])
}

/** 业务路由按模块追加到 children 中，meta.title 用于菜单与页面标题。插件路由来自 src/plugins。 */
export const routes: RouteRecordRaw[] = [
  {
    path: '/',
    name: 'layout',
    component: BasicLayout,
    children: [
      {
        path: '',
        name: 'home',
        component: () => import('@/views/HomeView.vue'),
        meta: { title: '首页' },
      },
{%- if include_example %}
      {
        path: 'example/notes',
        name: 'example-notes',
        component: () => import('@/views/example/ExampleNoteListView.vue'),
        meta: { title: '示例笔记' },
      },
{%- endif %}
      ...pluginRoutes(),
    ],
  },
]

export default createRouter({
  history: createWebHistory(),
  routes,
})
