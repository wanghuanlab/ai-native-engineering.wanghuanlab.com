#!/usr/bin/env bash
# 提交前检查：基线托管文件、迁移脚本、密钥、AI 配置一致性。只检查暂存区，几秒内完成。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python3 scripts/lib/checks.py managed --staged
python3 scripts/lib/checks.py migrations --staged
python3 scripts/lib/checks.py secrets --staged
python3 scripts/build-ai-config.py --check
