#!/usr/bin/env bash
# 推送前检查：只有技术负责人可以推送 main；推送前执行 verify.sh quick。
# 这是客户端约束，可被绕过。需要强制时在 Git 服务器上安装基线仓库的 tools/server-hooks/pre-receive。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pushing_main=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "${remote_ref}" = "refs/heads/main" ] && [ "${local_sha}" != "0000000000000000000000000000000000000000" ]; then
    pushing_main=1
  fi
done

if [ "${pushing_main}" = 1 ]; then
  me="$(git config user.name || true)"
  if ! python3 -c 'import json,sys; sys.exit(0 if sys.argv[1] in json.load(open(".baseline/project.json"))["techLeads"] else 1)' "${me}"; then
    echo "✗ 只有技术负责人可以推送 main。请推送功能分支（feat/<需求编号> 或 fix/<缺陷编号>），由技术负责人合并。" >&2
    echo "  当前 git user.name：${me:-未设置}" >&2
    exit 1
  fi
fi

if [ "${SKIP_VERIFY:-}" = 1 ]; then
  echo "! 已跳过推送前校验（SKIP_VERIFY=1）" >&2
  exit 0
fi
./scripts/verify.sh quick
