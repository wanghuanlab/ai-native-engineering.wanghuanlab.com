package {{ package_name }}.admin.domain;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import {{ package_name }}.common.error.BizException;
import org.junit.jupiter.api.Test;
import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;

class PasswordsTest {

    private static final String SEED_HASH = "$2a$10$E70dfmuzYY8OZwV5RMSGzevCli7R/83HB/dSv8aevdpPmNuxtHqle";

    @Test
    void rejectsShortPasswords() {
        assertThatThrownBy(() -> Passwords.require("short"))
                .isInstanceOf(BizException.class)
                .extracting(ex -> ((BizException) ex).errorCode())
                .isEqualTo(AdminErrorCode.PASSWORD_TOO_SHORT);
        Passwords.require("Admin@123");
    }

    @Test
    void seedHashMatchesTheInitialPassword() {
        assertThat(new BCryptPasswordEncoder().matches("Admin@123", SEED_HASH)).isTrue();
    }

    @Test
    void everyErrorCodeHasTextAndStatus() {
        for (AdminErrorCode code : AdminErrorCode.values()) {
            assertThat(code.code()).startsWith("B01");
            assertThat(code.message()).isNotBlank();
            assertThat(code.status()).isNotNull();
        }
    }
}
