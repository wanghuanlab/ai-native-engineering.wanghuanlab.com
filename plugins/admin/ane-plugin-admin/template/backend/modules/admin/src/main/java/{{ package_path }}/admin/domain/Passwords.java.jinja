package {{ package_name }}.admin.domain;

import {{ package_name }}.common.error.BizException;

/** 密码规则。哈希由服务层完成，这里只检查明文。 */
public final class Passwords {

    public static final int MIN_LENGTH = 8;

    private Passwords() {}

    public static void require(String raw) {
        if (raw == null || raw.length() < MIN_LENGTH) {
            throw new BizException(AdminErrorCode.PASSWORD_TOO_SHORT);
        }
    }
}
