spring:
  application:
    name: {{ project_code }}
  threads:
    virtual:
      enabled: true
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/{{ project_code }}}
    username: ${DB_USERNAME:{{ project_code }}}
    password: ${DB_PASSWORD:{{ project_code }}}
  jpa:
    open-in-view: false
    hibernate:
      # 表结构只能由迁移脚本修改；实体与表不一致时启动失败
      ddl-auto: validate
    properties:
      hibernate:
        jdbc.time_zone: UTC
  flyway:
    locations: classpath:db/migration/postgresql
    out-of-order: true
  mvc:
    problemdetails:
      enabled: true

server:
  port: ${SERVER_PORT:8080}

management:
  endpoints:
    web:
      exposure:
        include: health,info

logging:
  pattern:
    level: "%5p [%X{traceId:-}]"

# 接口文档。契约仍是事实源，这里只控制 Knife4j / springdoc 的展示。生产环境在 application-prod.yml 关闭。
springdoc:
  swagger-ui:
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
  api-docs:
    path: /v3/api-docs
  group-configs:
    - group: default
      paths-to-match: /api/**
      packages-to-scan: {{ package_name }}

knife4j:
  enable: true
  setting:
    language: zh_cn
