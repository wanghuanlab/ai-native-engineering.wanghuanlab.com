spring:
  application:
    name: {{ project_code }}
  threads:
    virtual:
      enabled: true
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/{{ project_code }}}
    username: ${DB_USERNAME:{{ project_code }}}
    password: ${DB_PASSWORD:{{ project_code }}}
  jpa:
    open-in-view: false
    hibernate:
      # 表结构只能由迁移脚本修改；实体与表不一致时启动失败
      ddl-auto: validate
    properties:
      hibernate:
        jdbc.time_zone: UTC
  flyway:
    locations: classpath:db/migration/postgresql
    out-of-order: true
  mvc:
    problemdetails:
      enabled: true

server:
  port: ${SERVER_PORT:8080}

management:
  endpoints:
    web:
      exposure:
        include: health,info

logging:
  pattern:
    level: "%5p [%X{traceId:-}]"
