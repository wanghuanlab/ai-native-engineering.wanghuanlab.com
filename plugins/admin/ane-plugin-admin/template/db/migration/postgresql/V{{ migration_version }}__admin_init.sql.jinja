-- 认证与权限。方言：PostgreSQL
-- 回退方式：按关联表、菜单、用户、角色、岗位、部门的顺序 DROP。

CREATE TABLE adm_dept (
    id          BIGINT                   NOT NULL,
    parent_id   BIGINT,
    name        VARCHAR(64)              NOT NULL,
    sort_order  INTEGER                  NOT NULL,
    ancestors   VARCHAR(500)             NOT NULL,
    created_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by  BIGINT                   NOT NULL,
    updated_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by  BIGINT                   NOT NULL,
    version     INTEGER                  NOT NULL DEFAULT 0,
    deleted     BOOLEAN                   NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_dept PRIMARY KEY (id)
);

CREATE TABLE adm_post (
    id          BIGINT                   NOT NULL,
    code        VARCHAR(64)              NOT NULL,
    name        VARCHAR(64)              NOT NULL,
    sort_order  INTEGER                  NOT NULL,
    enabled     BOOLEAN                   NOT NULL,
    created_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by  BIGINT                   NOT NULL,
    updated_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by  BIGINT                   NOT NULL,
    version     INTEGER                  NOT NULL DEFAULT 0,
    deleted     BOOLEAN                   NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_post PRIMARY KEY (id)
);

CREATE TABLE adm_role (
    id          BIGINT                   NOT NULL,
    code        VARCHAR(64)              NOT NULL,
    name        VARCHAR(64)              NOT NULL,
    data_scope  VARCHAR(32)              NOT NULL,
    enabled     BOOLEAN                   NOT NULL,
    created_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by  BIGINT                   NOT NULL,
    updated_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by  BIGINT                   NOT NULL,
    version     INTEGER                  NOT NULL DEFAULT 0,
    deleted     BOOLEAN                   NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_role PRIMARY KEY (id)
);

CREATE TABLE adm_user (
    id            BIGINT                   NOT NULL,
    dept_id       BIGINT                   NOT NULL,
    username      VARCHAR(64)              NOT NULL,
    password_hash VARCHAR(100)             NOT NULL,
    nickname      VARCHAR(64)              NOT NULL,
    enabled       BOOLEAN                   NOT NULL,
    created_at    TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by    BIGINT                   NOT NULL,
    updated_at    TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by    BIGINT                   NOT NULL,
    version       INTEGER                  NOT NULL DEFAULT 0,
    deleted       BOOLEAN                   NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_user PRIMARY KEY (id)
);

CREATE TABLE adm_menu (
    id          BIGINT                   NOT NULL,
    parent_id   BIGINT,
    name        VARCHAR(64)              NOT NULL,
    path        VARCHAR(128),
    component   VARCHAR(128),
    permission  VARCHAR(128),
    menu_type   VARCHAR(32)              NOT NULL,
    sort_order  INTEGER                  NOT NULL,
    visible     BOOLEAN                   NOT NULL,
    created_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by  BIGINT                   NOT NULL,
    updated_at  TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by  BIGINT                   NOT NULL,
    version     INTEGER                  NOT NULL DEFAULT 0,
    deleted     BOOLEAN                   NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_menu PRIMARY KEY (id)
);

CREATE TABLE adm_user_role (
    id         BIGINT  NOT NULL,
    user_id    BIGINT  NOT NULL,
    role_id    BIGINT  NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by BIGINT  NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by BIGINT  NOT NULL,
    version    INTEGER NOT NULL DEFAULT 0,
    deleted    BOOLEAN  NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_user_role PRIMARY KEY (id)
);

CREATE TABLE adm_user_post (
    id         BIGINT  NOT NULL,
    user_id    BIGINT  NOT NULL,
    post_id    BIGINT  NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by BIGINT  NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by BIGINT  NOT NULL,
    version    INTEGER NOT NULL DEFAULT 0,
    deleted    BOOLEAN  NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_user_post PRIMARY KEY (id)
);

CREATE TABLE adm_role_menu (
    id         BIGINT  NOT NULL,
    role_id    BIGINT  NOT NULL,
    menu_id    BIGINT  NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by BIGINT  NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by BIGINT  NOT NULL,
    version    INTEGER NOT NULL DEFAULT 0,
    deleted    BOOLEAN  NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_role_menu PRIMARY KEY (id)
);

CREATE TABLE adm_role_dept (
    id         BIGINT  NOT NULL,
    role_id    BIGINT  NOT NULL,
    dept_id    BIGINT  NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_by BIGINT  NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_by BIGINT  NOT NULL,
    version    INTEGER NOT NULL DEFAULT 0,
    deleted    BOOLEAN  NOT NULL DEFAULT FALSE,
    CONSTRAINT pk_adm_role_dept PRIMARY KEY (id)
);

CREATE INDEX idx_adm_user_username ON adm_user (username);
CREATE INDEX idx_adm_user_dept ON adm_user (dept_id);

