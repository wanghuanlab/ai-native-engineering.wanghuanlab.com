<template>
  <el-container class="layout">
    <el-aside :width="app.sidebarCollapsed ? '64px' : '220px'" class="layout__aside">
      <div class="layout__logo">{{ '{{' }} logoText {{ '}}' }}</div>
      <el-menu
        :default-active="route.path"
        :default-openeds="opened"
        :collapse="app.sidebarCollapsed"
        router
      >
        <MenuBranch :items="menus" />
      </el-menu>
    </el-aside>
    <el-container>
      <el-header class="layout__header">
        <el-button text @click="app.toggleSidebar()">{{ '{{' }} toggleText {{ '}}' }}</el-button>
        <span class="layout__title">{{ '{{' }} route.meta.title {{ '}}' }}</span>
        <el-button
          v-for="action in headerActions"
          :key="action.label"
          text
          @click="action.onClick()"
        >
          {{ '{{' }} action.label {{ '}}' }}
        </el-button>
      </el-header>
      <el-main>
        <router-view />
      </el-main>
    </el-container>
  </el-container>
</template>

<script setup lang="ts">
import MenuBranch from '@/layouts/MenuBranch.vue'
import { headerActionList, type MenuItem } from '@/plugins/host'
import { loadMenus } from '@/router/menus'
import { useAppStore } from '@/stores/app'
import { computed, ref, watchEffect } from 'vue'
import { useRoute } from 'vue-router'

const app = useAppStore()
const route = useRoute()

const projectName = '{{ project_name }}'
const logoText = computed(() => (app.sidebarCollapsed ? projectName.slice(0, 2) : projectName))
const toggleText = computed(() => (app.sidebarCollapsed ? '展开' : '收起'))

const menus = ref<MenuItem[]>([])
const headerActions = headerActionList()
const opened = computed(() => {
  const parts = route.path.split('/').filter(Boolean)
  const paths: string[] = []
  let current = ''
  for (const part of parts.slice(0, -1)) {
    current += `/${part}`
    paths.push(current)
  }
  return paths
})
watchEffect(async () => {
  menus.value = await loadMenus()
})
</script>

